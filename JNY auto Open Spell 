
// ==UserScript==
// @name        [JNY] Auto Open Spell ready
// @namespace   openspell
// @version     1.3
// @description Auto reopens last selected spell on Cast Spell page
// @match       https://elgea.illyriad.co.uk/*
// @run-at      document-end
// ==/UserScript==

(() => {

if (window.__illySpellAutoOpenRunning) return;
window.__illySpellAutoOpenRunning = true;

const TARGET_PATH = "#/Magic/Cast";
const KEY = "illy_spell_auto_open_v2";

let enabled = true;
let lastSpell = null;
let running = false;
let debounceTimer = null;
let observer = null;

// -------------------------
// PAGE CHECK
// -------------------------
function isTargetPage() {
    return location.hash.includes(TARGET_PATH);
}

// -------------------------
// STORAGE
// -------------------------
function load() {
    try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return;

        const data = JSON.parse(raw);

        enabled = data.enabled ?? true;
        lastSpell = data.lastSpell ?? null;
    } catch {}
}

function save() {
    localStorage.setItem(KEY, JSON.stringify({
        enabled,
        lastSpell
    }));
}

// -------------------------
// ROOT
// -------------------------
function getRoot() {
    return document.querySelector("#MainContentDiv") || document.body;
}

// -------------------------
// TRACK LAST SPELL
// -------------------------
function initTracking() {

    document.addEventListener("click", e => {

        const link = e.target.closest("h3.ui-accordion-header a");

        if (!link) return;

        lastSpell = link.textContent.trim();
        save();

    }, true);
}

// -------------------------
// OPEN LAST SPELL
// -------------------------
function openLastSpell() {

    if (!enabled) return;
    if (!lastSpell) return;
    if (running) return;
    if (!isTargetPage()) return;

    const root = getRoot();

    const headers = root.querySelectorAll(
        "h3.ui-accordion-header a"
    );

    if (!headers.length) return;

    const target = [...headers].find(h =>
        h.textContent.trim() === lastSpell
    );

    if (!target) return;

    const alreadyOpen =
        target.closest("h3")
            ?.classList.contains("ui-state-active");

    if (alreadyOpen) return;

    running = true;

    requestAnimationFrame(() => {
        target.click();
        running = false;
    });
}

// -------------------------
// TOGGLE
// -------------------------
function injectToggle() {

    if (!isTargetPage()) return;

    const icon = document.getElementById("vid");

    if (!icon) return;

    if (document.querySelector(".spell-toggle-btn")) return;

    const btn = document.createElement("span");

    const render = () => {
        btn.textContent = enabled ? "ON" : "OFF";
        btn.style.color = "black";
        btn.style.fontWeight = "bold";
        btn.style.cursor = "pointer";
        btn.style.textDecoration = "underline";
        btn.style.marginRight = "8px";
    };

    render();

    btn.addEventListener("click", () => {

        enabled = !enabled;

        save();
        render();

    });

    btn.className = "spell-toggle-btn";

    icon.parentElement.insertBefore(btn, icon);
}

// -------------------------
// DEBOUNCED UPDATE
// -------------------------
function scheduleUpdate() {

    clearTimeout(debounceTimer);

    debounceTimer = setTimeout(() => {

        if (!isTargetPage()) return;

        injectToggle();
        openLastSpell();

    }, 80);
}

// -------------------------
// OBSERVER CONTROL
// -------------------------
function stopWatcher() {

    if (!observer) return;

    observer.disconnect();
    observer = null;
}

function startWatcher() {

    stopWatcher();

    const root = getRoot();

    if (!root) return;

    observer = new MutationObserver(scheduleUpdate);

    observer.observe(root, {
        childList: true,
        subtree: true
    });
}

// -------------------------
// ROUTE HANDLER
// -------------------------
function handleRoute() {

    if (!isTargetPage()) {

        stopWatcher();
        return;
    }

    startWatcher();

    scheduleUpdate();
}

// -------------------------
// INIT
// -------------------------
function init() {

    load();

    initTracking();

    window.addEventListener(
        "hashchange",
        handleRoute
    );

    handleRoute();
}

init();

})();
