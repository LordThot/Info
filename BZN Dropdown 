(function() {
    'use strict';

    var columns = localStorage.getItem('TDR_column')
    let citiesMenuOpen = false;
    let cityLinkButtons = [];

    function calculateCityMenuCount() {
        const cityMenus = document.querySelectorAll('.cityMenu');
        return cityMenus.length;
    }

    function getMaxHeight() {
        const cityMenuCount = calculateCityMenuCount();
        const citiesMenu = document.getElementById('citiesMenu');
        if (citiesMenu) {
            const cityRows = Math.ceil(cityMenuCount / columns);
            const minHeight = 140;
            const maxHeight = Math.min(cityRows * 108, window.innerHeight - minHeight);
            return `${maxHeight}px`;
        }
    }
    
    function handleCityLinkButtonClick(cityMenu, event) {
        if (cityMenu) {
            let coordinatesElement = cityMenu.querySelector('div:nth-child(5) span[style*="font-weight:bold"]');
            if (!coordinatesElement || !coordinatesElement.textContent.includes(' | ')) {
                coordinatesElement = Array.from(cityMenu.querySelectorAll('span')).find(span => 
                    span.textContent.includes(' | ') && /^\-?\d+\s*\|\s*\-?\d+$/.test(span.textContent.trim())
                );
            }
            if (coordinatesElement) {
                const coordinatesText = coordinatesElement.textContent.trim();
                if (coordinatesText.includes(' | ')) {
                    const [x, y] = coordinatesText.split(' | ');
                    if (x && y && /^\-?\d+$/.test(x) && /^\-?\d+$/.test(y)) {
                        window.location.href = `https://elgea.illyriad.co.uk/#/Trade/Orders/${x}/${y}`;
                    }
                }
            }
        }
    }

    function addCityLinkButtons() {
        const existingButtons = document.querySelectorAll('.cityLinkButton');
        if (existingButtons.length === 0) {
            const cityMenus = document.querySelectorAll('.cityMenu');
            cityLinkButtons = [];
            cityMenus.forEach((cityMenu, index) => {
                const cityLinkButton = document.createElement('img');
                cityLinkButton.src = 'https://assets.illyriad.net/img/icons/trade/caravan_24.png';
                cityLinkButton.classList.add('cityLinkButton');
                cityLinkButton.style.zIndex = '9999';
                cityLinkButton.style.left = '50px';
                cityLinkButton.style.top = '25px';
                cityLinkButton.title = 'Open Trade';
                cityLinkButton.style.position = 'absolute';
                cityLinkButton.addEventListener('click', (event) => {
                    event.stopPropagation();
                    handleCityLinkButtonClick(cityMenu, event); // Use the current cityMenu
                });
                cityLinkButtons.push(cityLinkButton);
                cityMenu.appendChild(cityLinkButton);
            });
        }
    }

    function removeCityLinkButtons() {
        const cityLinkButtonsToRemove = document.querySelectorAll('.cityLinkButton');
        if (cityLinkButtonsToRemove.length !== 0) {
            cityLinkButtonsToRemove.forEach(button => {
                if (button && button.parentNode) {
                    button.parentNode.removeChild(button);
                }
            });
            cityLinkButtons = [];
        }
    }

    const maxHeightValue = getMaxHeight();

    const styles = `
    #citiesMenu {
        background: #E7D9A8;
        position: absolute;
        z-index: 20;
        width: calc(${columns}*159px);
        left: 32px;
        top: 105px;
        overflow-x: hidden;
        overflow-y: auto;
        padding: 10px;
        border-radius: 3px;
        border: 1px solid #bba377;
        box-shadow: 7px 7px 5px 0 rgba(50, 50, 50, .75);
        height: calc(100vh - 115px);
    }

    #citiesMenu.open {
        height: 100vh;
        visibility: visible;
        -moz-transition: height ease-out .25s, visibility 0s linear .25s;
        -o-transition: height ease-out .25s, visibility 0s linear .25s;
        -webkit-transition: height ease-out .25s, visibility 0s linear .25s;
        transition: height ease-out .25s, visibility 0s linear .25s;
    }

    #citiesMenu > div {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 5px;
    }

    .cityMenu {
        background-color: #e0cfc2;
        border: 1px solid #542d04;
        padding: 1px;
        border-radius: 5px;
        display: flex;
        flex-direction: column;
        width: 150px;
        box-sizing: border-box;
        white-space: nowrap;
        overflow: hidden;
    }

    .cityMenu.selected {
        border-color: #542d04;
        background-color: #E7D9A8;
    }

    .cityMenu:has(.cityResAlert > span[title*="Gold will run out"]) {
        background-color: #fa9f9f;
    }

    @media (min-height: 266px) {
        #citiesMenu.open {
            max-height: calc(${maxHeightValue});
        }
    }

    `;

    function addStyles(css) {
        const styleSheet = document.createElement("style");
        styleSheet.type = "text/css";
        styleSheet.innerText = css;
        document.head.appendChild(styleSheet);
    }

    addStyles(styles);

    const citiesMenuObserver = new MutationObserver(() => {
        const citiesMenu = document.getElementById('citiesMenu');
        if (citiesMenu) {
            setTimeout(() => {
                citiesMenuOpen = citiesMenu.classList.contains('open');
                if (citiesMenuOpen) {
                    addCityLinkButtons();
                } else {
                    removeCityLinkButtons();
                }
            }, 100);
        }
    });

    citiesMenuObserver.observe(document.documentElement, { childList: true, subtree: true });

})();