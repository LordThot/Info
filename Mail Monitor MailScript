function mailInitialize(){
	chrome.storage.local.get(null,function(items){
		if (chrome.runtime.lastError) {
			console.error(browser.runtime.lastError);
		} else {
			// Remove any monitor buttons in the menu bar
			let mButtons = document.querySelectorAll("#menuBar button");
			for(b=0;b<mButtons.length;b++){
				mButtons[b].remove();
			}
			let monitors = remove(Object.keys(items),"settings");
			let k = Object.keys(monitors);
			for (key in monitors){
				// add a button for this key
				var thisMon = items[monitors[key]];
				var b = document.createElement("button");
				let bText = thisMon.pid;
				if(thisMon.name >""){
					bText = thisMon.name + "(" + thisMon.pid + ")";
				}
				b.innerText = bText;
				b.dataset.id = thisMon.pid;
				document.querySelector("#menuBar").appendChild(b);
			}
		};
		document.querySelector("#menuBar").addEventListener("click", (e) => {
			monitorSelected(e);
		})
		document.querySelector("#filterBar").addEventListener("click", (e) => {
			filterSelected(e);
		})
		
		document.querySelector("#clearM").addEventListener("click", (e) => {
			confirmClear(e);
		})
		document.querySelector("#detailsTbl>tbody").addEventListener("click", (e) => {
			msgClicked(e);
		})
		document.querySelector("#msgClose").addEventListener("click", (e) => {
			document.querySelector("#singleMsgDiv").classList.add("nosee");
		})
		document.querySelector("#msgSave").addEventListener("click", (e) => {
			saveMsgHtml(e);
		})
		document.querySelector("#doSearch").addEventListener("click", (e) => {
			searchList(e);
		})
		document.querySelector("#delMsg").addEventListener("click", (e) => {
			deleteMsg(e);
		})
		document.querySelector("#keepMsg").addEventListener("click", (e) => {
			document.querySelector("#noMsgDiv").classList.add("nosee");
		})
		
	});
};

function deleteMsg(e){
	let mailId = e.target.dataset.id;
	let s=document.querySelector("#menuBar button.selected");
	let m = s.dataset.id;

	chrome.storage.local.get(m,function(results){
		if (chrome.runtime.lastError) {
			console.error(chrome.runtime.lastError);
		} else {
			let monitor = results[m];
			delete monitor.mails[mailId];
			chrome.storage.local.set({[monitor.pid]:monitor});
		}
	})
	document.querySelector("#noMsgDiv").classList.add("nosee");
	var rubbish = "";
}
