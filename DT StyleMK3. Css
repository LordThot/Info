/* These are the CSS variables used for setting the various colours used in the chats */
/* Need to find and add in NAP, Confed, War, friend & alliance member colours */
:root {
  --name_test: #704406;
  --name_def: #704406;
  --name_curr: #704406;

  --nameYou_test: #000000;
  --nameYou_def: #000000;
  --nameYou_curr: #000000;

  --nameGM_test: #0000ff;
  --nameGM_def: #0000ff;
  --nameGM_curr: #0000ff;

  --nameMod_test: #008000;
  --nameMod_def: #008000;
  --nameMod_curr: #008000;

  --nameSystem_test: #ff0000;
  --nameSystem_def: #ff0000;
  --nameSystem_curr: #ff0000;

  --nameFriend_def: #513f67;
  --nameFriend_curr: #513f67;
  --nameFriend_test: #513f67;

  --bkg_test: #ece9ce;
  --bkg_def: #ece9ce;
  --bkg_curr: #ece9ce;

  --mentions_test: #8315184d;
  --mentions_def: #8315184d;
  --mentions_curr: #8315184d;

  --trivia_test: #ffff00;
  --trivia_def: #ffff00;
  --trivia_curr: #ffff00;

  --time_test: #606060;
  --time_def: #606060;
  --time_curr: #606060;

  --text_test: #000000;
  --text_def: #000000;
  --text_curr: #000000;

  --diploAlliance_test: #0000ff;
  --diploAlliance_def: #0000ff;
  --diploAlliance_curr: #0000ff;

  --diploWar_test: #ff0000;
  --diploWar_def: #ff0000;
  --diploWar_curr: #ff0000;

  --diploConfed_test: #00ff00;
  --diploConfed_def: #00ff00;
  --diploConfed_curr: #00ff00;

  --diploNap_test: #ffff00;
  --diploNap_def: #ffff00;
  --diploNap_curr: #ffff00;
}
#gcTest,
#gcDef,
#gcCurr {
  & div.ui-dialog {
    padding: 0;
    border-width: 8px 6px;
    -moz-border-image: url(/img/backgrounds/border_tiny.png) 8 6 stretch;
    -webkit-border-image: url(/img/backgrounds/border_tiny.png) 8 6 stretch;
    -o-border-image: url(/img/backgrounds/border_tiny.png) 8 6 stretch;
    border-image: url(/img/backgrounds/border_tiny.png) 8 6 stretch;
    background-image: none;
    border-color: brown;
    border-style: ridge;
  }
}
#chats {
  width: 600px;
  height: auto;
}
#gcTest {
  border: solid 5px red;
  border-style: ridge;
}
#gcTest.globalChatTest {
  color: var(--text_test);

  & div.mentions {
    background-color: var(--mentions_test) !important;
    border-bottom: 1px solid #9a9a9a;
  }
  & div.trivia {
    background-color: var(--trivia_test) !important;
    border-bottom: 1px solid #9a9a9a;
  }
  & > div.oddeven:nth-child(odd) {
    background-color: var(--bkg_test);
  }
  & > div.oddeven:nth-child(even) {
    background-color: hsl(from var(--bkg_test) h s calc(l - 10));
  }
  & div.diploAlliance {
    border-left: 4px solid var(--diploAlliance_test);
  }
  & div.diploWar {
    border-left: 4px solid var(--diploWar_test);
  }
  & div.diploConfed {
    border-left: 4px solid var(--diploConfed_test);
  }
  & div.diploNap {
    border-left: 4px solid var(--diploNap_test);
  }

  & .time {
    color: var(--time_test);
  }
  & .name {
    color: var(--name_test);
  }
  & .nameYou {
    color: var(--nameYou_test);
  }
  & .nameFriend {
    color: var(--nameFriend_test);
  }
  & .nameGM {
    color: var(--nameGM_test);
  }
  & .nameMod {
    color: var(--nameMod_test);
  }
  & .nameSystem {
    color: var(--nameSystem_test);
  }
}
