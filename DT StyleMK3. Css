#chatTheme {
  display: flex;
}
#chats > div {
  max-height: 87%;
}

#colors {
  width: 600px;
  border: ridge brown;
  margin-inline: 3px;
  & #textTab,
  #rolesTab,
  #bkgsTab,
  #diploTab {
    display: flex;
    flex-flow: wrap;
  }
  & fieldset.role {
    width: 65px;
  }
  & button {
    background-image: none;
    background-color: darkgreen;
    color: palegreen;
    width: 12ch;
    margin: 3px !important;
    border-radius: 5px;
  }
}

.role {
  & input {
    width: 70px;
    display: block;
  }
  & label {
    display: block;
  }
  & label > span {
    height: 35px;
    /* text-align: center; */
    display: inline-block;
  }
  & label > span.c2 {
    height: auto;
  }
}
.c,
.c2 {
  width: 100%;
  text-align: center;
}

/* CSS for toggle switch start */
.switch {
  position: relative;
  display: inline-block;
  width: 90px;
  height: 40px;
  top: 0px;
}

.switch input {
  display: none;
}

.slider {
  position: absolute;
  cursor: pointer;
  top: 6px;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: darkgreen;
  -webkit-transition: 0.4s;
  transition: 0.4s;
  height: 40px;
}

.slider:before {
  position: absolute;
  content: "";
  height: 20px;
  width: 20px;
  left: 6px;
  /*! bottom: 5px; */
  background-color: white;
  -webkit-transition: 0.4s;
  transition: 0.4s;
}

input:checked + .slider {
  background-color: darkgreen;
}

input:focus + .slider {
  box-shadow: 0 0 1px #2196f3;
}

input:checked + .slider:before {
  -webkit-transform: translateX(55px);
  -ms-transform: translateX(55px);
  transform: translateX(55px);
}

/*------ ADDED CSS ---------*/
#colorSettings {
  & .on {
    display: none;
  }

  & .on,
  .off {
    color: palegreen;
    position: absolute;
    transform: translate(-50%, -50%);
    top: 25%;
    left: 50%;
    font-size: 10px;
    font-family: Verdana, sans-serif;
  }

  & input:checked + .slider .on {
    display: block;
  }

  & input:checked + .slider .off {
    display: none;
  }
}
/*--------- END --------*/

/* Rounded sliders */
.slider.round {
  border-radius: 34px;
}

.slider.round:before {
  border-radius: 50%;
}
