// ==UserScript==
// @name         [JNY] Move Logout ready
// @namespace    illy-ui-fixes
// @version      1.3
// @match        https://elgea.illyriad.co.uk/*
// @run-at       document-start
// ==/UserScript==

(() => {

    function fix() {
        const el = document.querySelector("img.logout");
        if (!el || el.dataset.fixed) return;

        el.dataset.fixed = "1";

        // hide immediately to prevent flash
        el.style.visibility = "hidden";

        requestAnimationFrame(() => {
            const rect = el.getBoundingClientRect();

            el.style.position = "fixed";
            el.style.zIndex = "2147483647";

            el.style.left = rect.left + "px";
            el.style.top = (rect.top - 15) + "px";

            el.style.visibility = "visible";
        });
    }

    const obs = new MutationObserver(fix);
    obs.observe(document.documentElement, { childList: true, subtree: true });

    fix();
})();